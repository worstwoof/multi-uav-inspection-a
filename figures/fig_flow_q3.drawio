        <mxCell id="t" value="问题三：动态禁飞区的几何—时间联合处理" style="text;html=1;fontSize=20;fontStyle=1;fontFamily=Noto Sans SC;fontColor=#25364A" vertex="1" parent="1"><mxGeometry x="570" y="25" width="560" height="35" as="geometry"/></mxCell>
        <mxCell id="a" value="输入 q2 路线、禁飞圆参数与时间窗&lt;br&gt;t=0 为 8:00，窗口为 [t_s,t_e)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FA;strokeColor=#1F6F8B;fontFamily=Noto Sans SC;fontSize=14" vertex="1" parent="1"><mxGeometry x="40" y="170" width="245" height="100" as="geometry"/></mxCell>
